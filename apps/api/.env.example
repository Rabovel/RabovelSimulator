# Pooled connection (pgbouncer) — used for regular queries
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/rabovel?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=0"
# Direct connection (no pooler) — required for Prisma interactive $transaction
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/rabovel?sslmode=require&connect_timeout=15"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Flutterwave — https://dashboard.flutterwave.com/settings/developers
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxx-X"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxx-X"
FLUTTERWAVE_ENCRYPTION_KEY="FLWSECK_TESTxxxxxxxx"
FLUTTERWAVE_WEBHOOK_SECRET="your-webhook-secret-hash"

# Staking reward job — pays daily yield to PRIMARY wallet (default: every 24h)
STAKING_REWARDS_ENABLED=true
STAKING_REWARD_INTERVAL_HOURS=24
# Set true to run once 10s after API startup (useful for local testing)
STAKING_REWARD_RUN_ON_START=false

# Vercel cron — required for daily staking rewards on serverless (generate a random string)
CRON_SECRET="your-random-cron-secret"
